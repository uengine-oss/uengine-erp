{
  "name": "uengine-erp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static web app for uEngine ERP. Talks only to the user's own Supabase project.",
  "license": "MIT",
  "scripts": {
    "gen": "node ../scripts/build-sql.mjs",
    "dev": "npm run gen && vite",
    "typecheck": "npm run gen && vue-tsc --noEmit",
    "build": "npm run gen && vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
