{
  "_": "SLA 기한의 경계 사례. test/helpdesk.test.mjs 가 사례마다 시험 하나를 만든다. 시각은 회사 시간대(Asia/Seoul)의 YYYY-MM-DDTHH:MM 이다. steps 의 do: create, tick(분마다 도는 작업 한 번), reply, wait, resume, solve, close, cancel, reopen, customer(고객 글), priority(value), status(그 시각의 SLA 상태). 2026-03-02 와 03-09, 03-16 은 월요일이고 03-16 은 아래 공휴일이다.",
  "holidays": [{ "date": "2026-03-16", "name": "시험 공휴일" }],
  "cases": [
    {
      "name": "첫 응답이 기한 정각에 오면 지킨 것이고, 정각에 도는 시계는 위반을 남기지 않는다",
      "policies": [{ "response_hours": 4, "resolve_hours": 24 }],
      "steps": [
        { "at": "2026-03-09T10:00", "do": "create" },
        { "at": "2026-03-09T14:00", "do": "status", "response": "at_risk" },
        { "at": "2026-03-09T14:00", "do": "tick" },
        { "at": "2026-03-09T14:00", "do": "reply" }
      ],
      "expect": { "response_due": "2026-03-09T14:00", "resolve_due": "2026-03-10T10:00", "response": "met", "breaches": [] }
    },
    {
