# Serves the static app. The nginx image fills in ${ERP_...} from the container's environment at start.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The app reads this when no connection is saved and skips the connect screen (web/src/lib/conn.ts).
    # It carries the setup code, which is acceptable only because this server listens on 127.0.0.1.
    location = /erp-config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 200 '{"url":"${ERP_API_URL}","key":"${ERP_ANON_KEY}","setupCode":"${ERP_SETUP_CODE}"}';
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }
}
